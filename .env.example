# Copy this file to .env.local and fill in your values.
# All variables must use the VITE_ prefix to be exposed to the browser.

# Spotify integration (optional — Music card requires this)
# Register your app at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Must match exactly a Redirect URI registered in your Spotify app dashboard.
# Register both URIs so local dev and production both work:
#   http://localhost:5173/callback
#   https://your-project.vercel.app/callback
#
# For local development:
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback
# For production, set this in Vercel → Settings → Environment Variables:
# VITE_SPOTIFY_REDIRECT_URI=https://your-project.vercel.app/callback
